# NiT Student Management — Backend Environment Variables
# Copy this file to .env and fill in your values.
# Railway: set these in the Railway dashboard under Variables.

# ── Security ──────────────────────────────────────────────────────────────────
SECRET_KEY=your_secret_key_here_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=129600
REFRESH_TOKEN_EXPIRE_DAYS=180

# Rotate access tokens proactively when < N seconds remain (default 5 min = 300s)
TOKEN_ROTATE_THRESHOLD=300

# Set to true to bind JWT tokens to the originating IP (not recommended behind Railway's proxy)
ENABLE_IP_BINDING=false

# ── Database ──────────────────────────────────────────────────────────────────
# Local dev:
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/nit_student_db
# Railway (auto-provided, the validator in config.py will add +asyncpg):
# DATABASE_URL=postgresql://user:password@host:port/dbname

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
# Redis with password (VPS):
# REDIS_URL=redis://:yourpassword@your-vps-ip:6379/0
# Railway Redis (auto-provided):
# REDIS_URL=redis://default:password@host:port

ENABLE_CACHE=true

# ── Frontend / CORS ───────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ── Server / Performance ─────────────────────────────────────────────────────
# Number of Gunicorn worker processes (default: min(2*CPU+1, 4))
# Set to 1 for Railway Hobby plan (512MB RAM), 2-4 for Pro plan
WORKER_CONCURRENCY=4

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ── Railway-specific (auto-set by Railway) ────────────────────────────────────
# RENDER_EXTERNAL_URL=https://your-app.up.railway.app  # if migrating from Render
# PORT=8000  # set by Railway automatically

# ── Admin seeding (optional) ──────────────────────────────────────────────────
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=ChangeMe@2026